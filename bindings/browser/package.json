{
  "name": "@ezone/browser",
  "version": "0.1.0",
  "description": "ezone passwordless SDK — browser client (WebCrypto + WebAuthn)",
  "type": "module",
  "main":  "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types":  "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev":   "tsc --watch",
    "prepublishOnly": "npm run build"
  },

{
  "name": "ezone-sdk",
  "version": "0.1.0",
  "description": "Passwordless authentication SDK — Node.js/TypeScript client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types":  "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev":   "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["passwordless", "authentication", "webauthn", "passkeys", "ezone"],
  "license": "MIT",
  "author": "ezone contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezone-sdk/ezone-sdk.git",
    "directory": "bindings/nodejs"
  },
  "homepage": "https://github.com/ezone-sdk/ezone-sdk/tree/main/bindings/nodejs#readme",
  "bugs": {
    "url": "https://github.com/ezone-sdk/ezone-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

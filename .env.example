# ── ezone environment variables ───────────────────────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=ezone
POSTGRES_USER=ezone
POSTGRES_PASSWORD=change_me_in_production

# ── Server keys (REQUIRED for production) ─────────────────────────────────────
# Session tokens, magic links, and recovery-code hashes are only valid
# against the exact keys that created them. Without these set, the server
# generates fresh random keys on every start and prints them once to its
# logs — meaning every restart invalidates every session/magic link, and you
# cannot run more than one instance (each would use different keys).
#
# Generate these ONCE (start the server with none of the three set, copy the
# three EZONE_* lines it prints to stderr into your secrets manager), then
# set all three here on every instance. They must be set together — partial
# configuration is rejected at startup.
# EZONE_HMAC_KEY=
# EZONE_TOKEN_PRIVATE_KEY=
# EZONE_TOKEN_PUBLIC_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Port to expose on the host
EZONE_PORT=8080

# Worker threads (default: 4)
EZONE_THREADS=4

# The frontend URL — used to build magic link URLs in emails
EZONE_APP_URL=https://yourapp.com

# CORS origin — set to your frontend origin, e.g. https://yourapp.com
# Leave blank to disable CORS headers (server-to-server mode)
EZONE_CORS_ORIGIN=https://yourapp.com

# Auth endpoint rate limit (requests per IP per minute, 0 = disabled)
EZONE_RATE_LIMIT=60

# Trust the X-Forwarded-For header for the client's real IP (used by rate
# limiting and QR-code IP binding). Only enable this if ezone sits behind a
# reverse proxy that overwrites/strips client-supplied X-Forwarded-For —
# otherwise any client can spoof this header to bypass both protections.
EZONE_TRUST_PROXY=false

# Distributed rate limiting (optional) — set EZONE_REDIS_HOST to share the
# rate limit across every replica of this server via Redis, instead of each
# process enforcing its own independent limit (the default). A Redis outage
# fails open (requests allowed, not blocked). Leave EZONE_REDIS_HOST unset
# for a single-instance deployment; no Redis is required.
#EZONE_REDIS_HOST=
#EZONE_REDIS_PORT=6379
#EZONE_REDIS_PASSWORD=

# Require FIPS 140-2/3 mode (optional, for regulated deployments). If set,
# ezone attempts to load OpenSSL's own validated FIPS provider at startup
# and refuses to start if none is available -- you must install/configure
# that provider yourself first (e.g. `openssl fipsinstall`, or your OS
# distribution's FIPS-validated OpenSSL package); ezone does not ship or
# validate it. Incompatible with a build using EZONE_USE_LIBSODIUM=ON
# (Ed25519/X25519/ChaCha20-Poly1305/Argon2id aren't FIPS-approved and
# bypass OpenSSL's provider system) -- refuses to start in that case too.
#EZONE_REQUIRE_FIPS=true

# ── Auth methods ──────────────────────────────────────────────────────────────
# Which auth methods this server exposes: "all", or a comma-separated list of
# challenge, magic_link, recovery, webauthn, qr_code, push, otp.
# Default (unset): challenge, magic_link, recovery only.
EZONE_ENABLED_METHODS=all

# WebAuthn's Relying Party ID MUST match the domain serving your app (e.g.
# "yourapp.com") — the "localhost" default only works for local development.
# WebAuthn registration/login silently fails with an origin mismatch if this
# is wrong in production.
EZONE_WEBAUTHN_RP_ID=yourapp.com
EZONE_WEBAUTHN_RP_NAME=Your App Name

# ── Email ─────────────────────────────────────────────────────────────────────
# "log"    — print magic links to stdout (development only)
# "resend" — send real emails via Resend API (production)
EZONE_EMAIL_PROVIDER=resend

# Required when EZONE_EMAIL_PROVIDER=resend
EZONE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EZONE_EMAIL_FROM=ezone <auth@yourapp.com>

# Optional email subject overrides
# EZONE_SUBJECT_REGISTER=Complete your registration
# EZONE_SUBJECT_LOGIN=Your sign-in link
# EZONE_SUBJECT_RESET=Reset your account
# EZONE_SUBJECT_ADD_DEVICE=Approve new device

# ── TLS (optional — recommended in production) ────────────────────────────────
# Place your PEM cert and key in a ./certs/ directory and set paths.
# With a reverse proxy (nginx, Caddy), leave these blank — let the proxy handle TLS.
# EZONE_CERT_DIR=./certs
# EZONE_TLS_CERT=/certs/fullchain.pem
# EZONE_TLS_KEY=/certs/privkey.pem

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Include connect_timeout (seconds) in your own connection string -- libpq has
# no default, so during an outage a reconnect attempt can otherwise hang far
# longer than you'd want before failing. E.g.:
#   postgresql://user:pass@host:5432/db?connect_timeout=5
# (docker-compose.yml/render.yaml build EZONE_DATABASE_URL for you without
# this by default -- add it to POSTGRES_* / your own override if you set one.)
#EZONE_DATABASE_URL=postgresql://ezone:changeme@localhost:5432/ezone?connect_timeout=5
EZONE_DB_POOL_SIZE=8

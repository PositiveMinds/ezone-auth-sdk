# Secrets — never commit these
.env

# Build output
build/
cmake-build-*/
*.o
*.obj
*.a
*.so
*.dylib
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
_deps/

# Node.js bindings/docs (bindings/nodejs, bindings/browser, docs) —
# package-lock.json IS committed (npm ci in CI requires it); node_modules/
# and build output are not.
node_modules/
bindings/*/dist/
*.tgz
docs/.docusaurus/

# Python bindings build output
__pycache__/
*.egg-info/
bindings/python/build/
bindings/python/dist/
